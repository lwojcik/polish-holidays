{
  "name": "polish-holidays",
  "version": "0.2.0",
  "description": "Polish public holidays, state and national days and trading Sundays, computed from the statutes: for any year, with the legal basis of each day.",
  "keywords": [
    "polish",
    "poland",
    "holidays",
    "public-holidays",
    "trading-sundays",
    "niedziele-handlowe",
    "calendar",
    "pl"
  ],
  "license": "MIT",
  "author": "Łukasz Wójcik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwojcik/polish-holidays.git"
  },
  "bugs": "https://github.com/lwojcik/polish-holidays/issues",
  "homepage": "https://github.com/lwojcik/polish-holidays#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "czg",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "prepublishOnly": "npm run build",
    "release": "HUSKY=0 GITHUB_TOKEN=$(gh auth token) release-it --no-increment --no-git.commit",
    "release:prepare": "scripts/release-prepare.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lwojcik/eslint-config": "0.3.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "26.6.10",
    "@vitest/coverage-v8": "5.1.1",
    "czg": "1.14.0",
    "eslint": "^10.15.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "release-it": "^21.1.3",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "5.1.1"
  }
}
